# ── Environment & secrets ──────────────────────────────────────
config/env.php

# ── Composer dependencies ──────────────────────────────────────
/vendor/
/PHPMailer-master/

# ── Uploaded files (keep folder, ignore contents) ─────────────
/storage/uploads/*
!/storage/uploads/.gitkeep

# ── Generated / downloaded assets (not source code) ───────────
/storage/cacert.pem
/storage/vicinity_maps/
/storage/tmp/

# ── OS & editor noise ──────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ── PHP / runtime ──────────────────────────────────────────────
*.log
*.cache
